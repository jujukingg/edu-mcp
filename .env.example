# Configuration Edu MCP Server
# ================================

# Plateforme : "pronote" (défaut), "ecoledirecte" ou "skolengo"
EDU_PLATFORM=pronote

# Option A : Connexion Pronote (+ ENT) avec identifiant / mot de passe ou navigateur SSO
PRONOTE_URL=https://demo.pronote.index-education.net/pronote/eleve.html
PRONOTE_USERNAME=demonstration
PRONOTE_PASSWORD=demonstration

# Type de compte : "student" (élève, défaut) ou "parent"
PRONOTE_ACCOUNT_TYPE=student

# Nom de l'ENT si applicable (ex: ile_de_france, monbureaunumerique, toutatice, atrium_sud, etc.)
PRONOTE_ENT=

# Code PIN 2FA / Nom de l'appareil
PRONOTE_ACCOUNT_PIN=0000
PRONOTE_DEVICE_NAME=Mon Appareil MCP

# Fichier de cache de session (défaut : ~/.edu_mcp/.session_cache.pkl)
# PRONOTE_SESSION_FILE=.session_cache.pkl

# Option B : Authentification Pronote par Token / QR-Code (généré automatiquement)
# PRONOTE_TOKEN=votre_token_64_chars
# PRONOTE_UUID=votre_uuid

# Option C : ÉcoleDirecte (jetons appareil de confiance QCM 2FA)
# EDU_ED_CN=
# EDU_ED_CV=

# Option D : Skolengo (OAuth2 PKCE)
# EDU_SKOLENGO_TOKEN=
# EDU_SKOLENGO_REFRESH_TOKEN=
# EDU_SKOLENGO_SCHOOL_ID=
# EDU_SKOLENGO_EMS_CODE=
# EDU_SKOLENGO_OIDC_URL=

# Pour un compte parent avec plusieurs enfants
# PRONOTE_CHILD_NAME=Alexandre

PRONOTE_CACHE_TTL=180
PRONOTE_TIMEOUT=30
PRONOTE_DOWNLOAD_DIR=./downloads
